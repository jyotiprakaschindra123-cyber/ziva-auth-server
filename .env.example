# Postgres connection string. On Vercel, connect a Postgres/Neon database and
# copy its pooled connection string here (Project -> Settings -> Environment Variables).
DATABASE_URL=postgres://user:password@host:5432/db?sslmode=require

# Long random secret used to hash session tokens. Change this in production.
ZIVA_TOKEN_PEPPER=replace-with-a-long-random-string

# Bearer token for /api/admin/*. Leave empty to disable the admin API.
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Optional policy knobs.
ZIVA_SESSION_TTL_SECONDS=28800
ZIVA_HEARTBEAT_SECONDS=60
ZIVA_MAX_DEVICES=10
ZIVA_MAX_LOGIN_FAILURES=8
ZIVA_LOGIN_WINDOW_SECONDS=300
ZIVA_CLOCK_SKEW_SECONDS=300
